{
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "thanos.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "lib/hands/hands.js",
        "thanos-hand.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "description": "Snap your fingers on camera: you dissolve into dust and your mic mutes. Snap again: you reassemble and unmute.",
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "manifest_version": 3,
  "name": "Thanos Snap for Google Meet",
  "permissions": [],
  "version": "3.0.0",
  "web_accessible_resources": [
    {
      "resources": [
        "lib/hands/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}